  "cards": [
    {
      "dot": "emerald",
      "title": "Identity & state",
      "items": [
        "API auth (Bearer token) happens before any user_id may select a thread or memory owner",
        "/clear rotates thread_id only — durable memory ownership is a stable hashed owner key",
        "Four state layers: thread summary, checkpoint, business data, durable memory"
      ]
    },
    {
      "dot": "cyan",
      "title": "Durable memory contract",
      "items": [
        "Only explicit commands (记住 / 记下来 / 更新 / 忘掉) authorize a mutation",
        "Specialists fresh-read memory for their own prompts; no competing state snapshots",
        "refresh_memories performs the single final write after every branch, interrupt resume included"
      ]
    },
    {
      "dot": "rose",
      "title": "Cross-cutting systems",
      "items": [
        "Evaluation: one business DB + one memory DB per case, case_id as thread and user identity",
        "Observability: one trace_id per request; Langfuse receives optional masked traces",
        "Proactive review: JobQueue calls /proactive-review daily at 21:00 Asia/Shanghai"
      ]
    }
  ]
